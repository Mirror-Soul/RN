# 서버 API Base URL (Swagger: {BASE_URL}/swagger-ui/index.html)
EXPO_PUBLIC_API_BASE_URL=https://your-api-server.com

# Sentry DSN (https://sentry.io 프로젝트 생성 후 발급). 비워두면 크래시 리포팅이 비활성화됩니다.
EXPO_PUBLIC_SENTRY_DSN=

# Google Maps SDK 키 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급,
# "Maps SDK for iOS"/"Maps SDK for Android" 각각 사용 설정 필요). app.config.js가 prebuild
# 시점에만 읽는다 — Discovery 탐색 지역 화면은 항상 Google Maps provider를 쓰므로 필수다.
# 비워두면 Android에서 빈 회색 지도가 뜨고, app.config.js가 prebuild 시 터미널에 경고한다.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
